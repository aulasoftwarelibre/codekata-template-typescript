{
  "name": "Node.js & TypeScript",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",
  "postCreateCommand": "pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "vitest.explorer",
        "usernamehw.errorlens"
      ]
    }
  }
}
